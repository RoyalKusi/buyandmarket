APP_NAME=BuyAndMarket
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Harare
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# TDD §2.1: MySQL/MariaDB, preserving compatibility with the current
# Hostinger environment for a low-risk migration path (§10).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=buyandmarket
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# TDD §2.1/§9.3: database-driven queues/cache are the Hostinger Cloud
# Startup launch fallback; switch both to "redis" where the plan tier
# provides a persistent Redis process — no application-code change needed.
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# TDD §7.1: domains that receive stateful, cookie-based API authentication
# for the Livewire web client (Sanctum). Add each environment's real host.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# TDD §7.4: PaymentGateway implementations (App\Services\Payments). Set
# real values only in an untracked .env — never commit them (TDD §8.6).
PESEPAY_INTEGRATION_KEY=
PESEPAY_ENCRYPTION_KEY=
PESEPAY_BASE_URL=https://api.pesepay.com/api/payments-engine/v1
PESEPAY_RESULT_URL=
PESEPAY_RETURN_URL=

PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
PAYNOW_BASE_URL=https://www.paynow.co.zw/interface
PAYNOW_RESULT_URL=
PAYNOW_RETURN_URL=

# TDD §5/§8.4: App\Contracts\Ai\LlmProvider / EmbeddingProvider. Set real
# values only in an untracked .env — never commit them (TDD §8.6).
AI_API_KEY=
AI_CHAT_URL=https://api.openai.com/v1/chat/completions
AI_CHAT_MODEL=gpt-4o-mini
AI_EMBEDDINGS_URL=https://api.openai.com/v1/embeddings
AI_EMBEDDING_MODEL=text-embedding-3-small

VITE_APP_NAME="${APP_NAME}"
